# WorkBuddy 本地数据（工作日志、会话记忆），不随仓库共享
.workbuddy/

# Node / 构建产物
node_modules/
dist/
.turbo/
*.tsbuildinfo

# 本地凭据（Supabase 本地栈的 publishable key 等），绝不入库
.env
.env.local
.env.*.local

# Supabase 本地栈临时文件
supabase/.temp/

# Docker 部署的本地环境变量（含后端 key）
.env.docker

# Android 构建产物（本地出包，不入库）
*.apk
*.aab
artifacts/atomic-english-debug.apk
